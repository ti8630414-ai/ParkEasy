@using ParkEasy.Web.Models.Enums
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ParkEasy Smart Parking System</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Leaflet Maps CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-top pe-nav">
        <nav class="navbar navbar-expand-lg navbar-dark py-2">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-p-square-fill me-2 fs-4 text-white"></i>
                    <span>ParkEasy</span>
                    <span class="brand-badge">Smart Parking</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-controller="Parking" asp-action="Index">
                                Find Parking
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-controller="Home" asp-action="About">
                                About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-controller="Home" asp-action="Contact">
                                Contact
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium" asp-controller="Home" asp-action="Help">
                                Help
                            </a>
                        </li>

                        @if (User.IsInRole(UserRoles.Owner) || User.IsInRole(UserRoles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-success fw-semibold" href="#" id="ownerMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-building me-1"></i>Owner Portal
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="ownerMenu">
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Owner Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="Spaces"><i class="bi bi-p-square me-2"></i>My Parking Spaces</a></li>
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="CreateSpace"><i class="bi bi-plus-circle me-2"></i>Add New Space</a></li>
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="Requests"><i class="bi bi-calendar-check me-2"></i>Booking Requests</a></li>
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="Earnings"><i class="bi bi-graph-up-arrow me-2"></i>Earnings & Revenue</a></li>
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="Occupancy"><i class="bi bi-pie-chart me-2"></i>Occupancy Status</a></li>
                                    <li><a class="dropdown-item" asp-controller="Owner" asp-action="Refunds"><i class="bi bi-arrow-counterclockwise me-2"></i>Refund Management</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole(UserRoles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger fw-semibold" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i>Admin Panel
                                </a>
                                <ul class="dropdown-menu shadow-sm" aria-labelledby="adminMenu">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid-1x2 me-2"></i>Admin Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>User Management</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Spaces"><i class="bi bi-p-square me-2"></i>System Spaces</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Bookings"><i class="bi bi-journal-bookmark me-2"></i>Global Bookings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Payments"><i class="bi bi-cash me-2"></i>Global Payments</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Refunds"><i class="bi bi-cash-stack me-2"></i>System Refunds</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="SystemHealth"><i class="bi bi-activity me-2"></i>System Health</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-3">
        <partial name="_AlertMessages" />
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;"></div>

    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Demo Credentials Modal -->
    <div class="modal fade" id="demoAccountsModal" tabindex="-1" aria-labelledby="demoAccountsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="demoAccountsModalLabel"><i class="bi bi-key-fill me-2"></i>Demo Login Credentials</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info py-2">
                        <small>Use these seeded accounts for instant evaluation and testing of all roles.</small>
                    </div>
                    <div class="list-group">
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-danger mb-1">Admin</span>
                                <div><strong>admin@parkeasy.com</strong></div>
                                <small class="text-muted">Password: <code>Admin@123456</code></small>
                            </div>
                            <button class="btn btn-sm btn-outline-danger" onclick="fillLoginForm('admin@parkeasy.com', 'Admin@123456')">Use</button>
                        </div>
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-success mb-1">Owner</span>
                                <div><strong>owner@parkeasy.com</strong></div>
                                <small class="text-muted">Password: <code>Owner@123456</code></small>
                            </div>
                            <button class="btn btn-sm btn-outline-success" onclick="fillLoginForm('owner@parkeasy.com', 'Owner@123456')">Use</button>
                        </div>
                        <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-primary mb-1">Driver</span>
                                <div><strong>user@parkeasy.com</strong></div>
                                <small class="text-muted">Password: <code>User@123456</code></small>
                            </div>
                            <button class="btn btn-sm btn-outline-primary" onclick="fillLoginForm('user@parkeasy.com', 'User@123456')">Use</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="pe-footer text-light py-4 mt-auto">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-5">
                    <h5 class="fw-bold mb-1 text-white"><i class="bi bi-p-square-fill text-white me-2"></i>ParkEasy</h5>
                    <p class="small mb-0" style="color: var(--pe-muted);">Smart Parking Slot Booking System &copy; 2026. Built with ASP.NET Core MVC & PostgreSQL.</p>
                </div>
                <div class="col-md-4 text-md-center">
                    <button type="button" class="btn btn-glass btn-sm rounded-pill" data-bs-toggle="modal" data-bs-target="#demoAccountsModal">
                        <i class="bi bi-key me-1"></i>View Demo Accounts
                    </button>
                </div>
                <div class="col-md-3 text-md-end">
                    <span class="badge bg-secondary">.NET 8</span>
                    <span class="badge bg-secondary">PostgreSQL</span>
                    <span class="badge bg-secondary">SignalR</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Microsoft SignalR JS Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <!-- Leaflet Maps JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function fillLoginForm(email, password) {
            const emailInput = document.getElementById('Email');
            const passInput = document.getElementById('Password');
            if (emailInput && passInput) {
                emailInput.value = email;
                passInput.value = password;
                const modal = bootstrap.Modal.getInstance(document.getElementById('demoAccountsModal'));
                if (modal) modal.hide();
            } else {
                window.location.href = `/Account/Login?demoEmail=${encodeURIComponent(email)}&demoPass=${encodeURIComponent(password)}`;
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
