@using Microsoft.AspNetCore.Identity
@using ParkEasy.Web.Models.Entities
@using ParkEasy.Web.Models.Enums
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var roles = user != null ? await UserManager.GetRolesAsync(user) : new List<string>();
    var primaryRole = roles.FirstOrDefault() ?? "User";

    <!-- Notification Bell -->
    <li class="nav-item me-2">
        <a class="nav-link position-relative px-2" asp-controller="Notification" asp-action="Index" title="Notifications">
            <i class="bi bi-bell fs-5"></i>
            <span id="notif-badge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none">
                0
            </span>
        </a>
    </li>

    <!-- Role Badge -->
    <li class="nav-item me-2 d-none d-lg-block">
        @if (primaryRole == UserRoles.Admin)
        {
            <span class="badge bg-danger">Admin</span>
        }
        else if (primaryRole == UserRoles.Owner)
        {
            <span class="badge bg-success">Owner</span>
        }
        else
        {
            <span class="badge bg-primary">Driver</span>
        }
    </li>

    <!-- User Dropdown -->
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle fw-semibold d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.85rem;">
                @(user?.FullName?.Substring(0, 1).ToUpper() ?? "U")
            </div>
            <span>@(user?.FullName ?? User.Identity?.Name)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userDropdown">
            @if (User.IsInRole(UserRoles.Admin))
            {
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-danger"></i>Admin Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>Manage Users</a></li>
                <li><a class="dropdown-item" asp-controller="Admin" asp-action="SystemHealth"><i class="bi bi-heart-pulse me-2"></i>System Health</a></li>
                <li><hr class="dropdown-divider"></li>
            }

            @if (User.IsInRole(UserRoles.Owner) || User.IsInRole(UserRoles.Admin))
            {
                <li><a class="dropdown-item" asp-controller="Owner" asp-action="Dashboard"><i class="bi bi-grid-1x2 me-2 text-success"></i>Owner Dashboard</a></li>
                <li><a class="dropdown-item" asp-controller="Owner" asp-action="Spaces"><i class="bi bi-p-square me-2"></i>My Parking Spaces</a></li>
                <li><a class="dropdown-item" asp-controller="Owner" asp-action="Requests"><i class="bi bi-calendar-check me-2"></i>Booking Requests</a></li>
                <li><a class="dropdown-item" asp-controller="Owner" asp-action="Earnings"><i class="bi bi-cash-stack me-2"></i>Earnings & Revenue</a></li>
                <li><hr class="dropdown-divider"></li>
            }

            <li><a class="dropdown-item" asp-controller="Booking" asp-action="History"><i class="bi bi-journal-text me-2 text-primary"></i>My Bookings</a></li>
            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person-gear me-2"></i>Profile & Vehicle</a></li>
            <li><a class="dropdown-item" asp-controller="Notification" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link fw-medium" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
        </a>
    </li>
    <li class="nav-item ms-lg-2">
        <a class="btn btn-primary btn-sm px-3 rounded-pill" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i>Register
        </a>
    </li>
}
</ul>
