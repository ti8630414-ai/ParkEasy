@model List<ParkEasy.Web.Models.Entities.Payment>
@using ParkEasy.Web.Models.Enums
@using ParkEasy.Web.Helpers
@{
    ViewData["Title"] = "Global Payments Ledger";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-credit-card-2-front-fill text-success me-2"></i>Global Payments Ledger</h2>
            <p class="text-muted mb-0">Complete transaction history across all parking facilities</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Txn Ref</th>
                        <th>Booking Ref</th>
                        <th>User</th>
                        <th>Facility</th>
                        <th>Method</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <code class="fw-bold text-dark">@p.TransactionId</code>
                            </td>
                            <td>
                                <a asp-controller="Booking" asp-action="Details" asp-route-id="@p.BookingId" class="font-monospace fw-bold text-decoration-none">
                                    @p.Booking.BookingReference
                                </a>
                            </td>
                            <td>
                                <div><strong>@(p.Booking.User?.FullName ?? "User")</strong></div>
                                <small class="text-muted">@p.Booking.User?.Email</small>
                            </td>
                            <td>@p.Booking.ParkingSpace?.Name</td>
                            <td>
                                <span class="badge bg-light text-dark border">@p.PaymentMethod.ToLabel()</span>
                            </td>
                            <td class="fw-bold text-success fs-6">৳@p.Amount.ToString("F2")</td>
                            <td>
                                @if (p.Status == PaymentStatus.Paid)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                }
                                else if (p.Status == PaymentStatus.Refunded)
                                {
                                    <span class="badge bg-info text-dark">Refunded</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@p.Status</span>
                                }
                            </td>
                            <td class="small text-muted">@p.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
