@model ParkEasy.Web.Models.ViewModels.UserManagementViewModel
@using ParkEasy.Web.Models.Enums
@{
    ViewData["Title"] = "User Management";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-people-fill text-primary me-2"></i>User Management</h2>
            <p class="text-muted mb-0">Manage registered Driver, Owner, and Admin accounts</p>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="card border-0 shadow-sm p-3 mb-4">
        <form method="get" asp-action="Users" class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" asp-for="SearchQuery" class="form-control form-control-sm" placeholder="Search by name or email address..." />
            </div>
            <div class="col-md-3">
                <select asp-for="SelectedRole" class="form-select form-select-sm">
                    <option value="">All Roles</option>
                    <option value="Admin">Admin</option>
                    <option value="Owner">Owner</option>
                    <option value="User">Driver</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill fw-bold">Filter</button>
                <a asp-action="Users" class="btn btn-light btn-sm text-muted">Reset</a>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User Name</th>
                        <th>Email & Phone</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Activity</th>
                        <th>Joined</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        @foreach (var u in Model.Users)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@u.FullName</div>
                                    @if (!string.IsNullOrEmpty(u.VehiclePlateNumber))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-car-front me-1"></i>@u.VehiclePlateNumber</small>
                                    }
                                </td>
                                <td>
                                    <div>@u.Email</div>
                                    <small class="text-muted">@(u.PhoneNumber ?? "No Phone")</small>
                                </td>
                                <td>
                                    @if (u.Role == UserRoles.Admin)
                                    {
                                        <span class="badge bg-danger">Admin</span>
                                    }
                                    else if (u.Role == UserRoles.Owner)
                                    {
                                        <span class="badge bg-success">Owner</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Driver</span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Deactivated</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted d-block">Bookings: <strong>@u.TotalBookings</strong></small>
                                    @if (u.Role == UserRoles.Owner)
                                    {
                                        <small class="text-muted d-block">Spaces: <strong>@u.TotalSpacesOwned</strong></small>
                                    }
                                </td>
                                <td class="small text-muted">@u.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#editRoleModal-@u.Id" title="Change Role">
                                        <i class="bi bi-shield-shaded"></i> Role
                                    </button>

                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline" onsubmit="return confirm('Change active status for @u.FullName?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(u.IsActive ? "Deactivate User" : "Activate User")">
                                            <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                        </button>
                                    </form>

                                    <!-- Edit Role Modal -->
                                    <div class="modal fade text-start" id="editRoleModal-@u.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <div class="modal-header bg-primary text-white">
                                                    <h5 class="modal-title">Change Role - @u.FullName</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="ChangeUserRole" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="UserId" value="@u.Id" />
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-bold">Select New Role</label>
                                                            <select name="NewRole" class="form-select">
                                                                <option value="@UserRoles.User" selected="@(u.Role == UserRoles.User)">Driver</option>
                                                                <option value="@UserRoles.Owner" selected="@(u.Role == UserRoles.Owner)">Owner</option>
                                                                <option value="@UserRoles.Admin" selected="@(u.Role == UserRoles.Admin)">Admin</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary fw-bold">Update Role</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No users matched your search criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
