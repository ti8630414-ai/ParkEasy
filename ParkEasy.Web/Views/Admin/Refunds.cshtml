@model List<ParkEasy.Web.Models.Entities.Refund>
@using ParkEasy.Web.Models.Enums
@{
    ViewData["Title"] = "Global Refunds";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-arrow-counterclockwise text-info me-2"></i>Global Refund Management</h2>
            <p class="text-muted mb-0">System-wide cancellation and refund activity records</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Booking Ref</th>
                        <th>User</th>
                        <th>Parking Space</th>
                        <th>Amount</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Processed On</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace fw-bold text-primary">@r.Booking.BookingReference</span>
                                </td>
                                <td>
                                    <div><strong>@(r.Booking.User?.FullName ?? "Customer")</strong></div>
                                    <small class="text-muted">@r.Booking.User?.Email</small>
                                </td>
                                <td>@r.Booking.ParkingSpace?.Name</td>
                                <td class="fw-bold text-danger fs-6">৳@r.Amount.ToString("F2")</td>
                                <td>
                                    <span class="small text-secondary">@(r.Reason ?? "Cancelled")</span>
                                </td>
                                <td>
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>@r.Status</span>
                                </td>
                                <td class="small text-muted">@r.CreatedAt.ToString("g")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No refund records in system.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
