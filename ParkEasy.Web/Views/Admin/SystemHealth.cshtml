@model ParkEasy.Web.Models.ViewModels.SystemHealthViewModel
@{
    ViewData["Title"] = "System Health & Diagnostics";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-heart-pulse-fill text-danger me-2"></i>System Diagnostics & Health</h2>
            <p class="text-muted mb-0">Live status of backend services, database connections, and engines</p>
        </div>
    </div>

    <!-- Health Status Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="stat-icon bg-primary bg-opacity-10 text-primary me-3">
                        <i class="bi bi-database-check"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Database Provider</h6>
                        <span class="badge bg-success">Operational</span>
                    </div>
                </div>
                <p class="small text-muted mb-0">@Model.DatabaseStatus</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="stat-icon bg-success bg-opacity-10 text-success me-3">
                        <i class="bi bi-broadcast"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">Real-Time Engine</h6>
                        <span class="badge bg-success">Online</span>
                    </div>
                </div>
                <p class="small text-muted mb-0">@Model.SignalRStatus</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="d-flex align-items-center mb-3">
                    <div class="stat-icon bg-info bg-opacity-10 text-info me-3">
                        <i class="bi bi-qr-code"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0">QR Code Engine</h6>
                        <span class="badge bg-success">Active</span>
                    </div>
                </div>
                <p class="small text-muted mb-0">@Model.QrGeneratorStatus</p>
            </div>
        </div>
    </div>

    <!-- System Metrics Breakdown -->
    <div class="card border-0 shadow-sm p-4 mb-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-cpu text-primary me-2"></i>Database Entity Inventory</h5>
        <div class="row g-3 text-center">
            <div class="col-4 col-md-2">
                <div class="p-3 bg-light rounded-3">
                    <small class="text-muted d-block">Users</small>
                    <strong class="fs-4 text-primary">@Model.TotalRegisteredUsers</strong>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="p-3 bg-light rounded-3">
                    <small class="text-muted d-block">Spaces</small>
                    <strong class="fs-4 text-dark">@Model.TotalSpaces</strong>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="p-3 bg-light rounded-3">
                    <small class="text-muted d-block">Slots</small>
                    <strong class="fs-4 text-info">@Model.TotalSlots</strong>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="p-3 bg-light rounded-3">
                    <small class="text-muted d-block">Bookings</small>
                    <strong class="fs-4 text-warning">@Model.TotalBookings</strong>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="p-3 bg-light rounded-3">
                    <small class="text-muted d-block">Payments</small>
                    <strong class="fs-4 text-success">@Model.TotalPayments</strong>
                </div>
            </div>
            <div class="col-4 col-md-2">
                <div class="p-3 bg-light rounded-3">
                    <small class="text-muted d-block">Alerts</small>
                    <strong class="fs-4 text-secondary">@Model.TotalNotifications</strong>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex justify-content-between text-muted small">
            <span>Server Time: <strong>@Model.ServerTimeUtc</strong></span>
            <span>Framework: <strong>.NET 8.0 / ASP.NET Core MVC</strong></span>
        </div>
    </div>
</div>
