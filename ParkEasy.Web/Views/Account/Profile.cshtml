@model ParkEasy.Web.Models.ViewModels.ProfileViewModel
@using ParkEasy.Web.Models.Enums
@{
    ViewData["Title"] = "User Profile";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- Sidebar Summary -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center">
                <div class="rounded-circle bg-primary text-white mx-auto d-flex align-items-center justify-content-center mb-3 shadow" style="width: 80px; height: 80px; font-size: 2rem;">
                    @Model.FullName.Substring(0, 1).ToUpper()
                </div>
                <h4 class="fw-bold mb-1">@Model.FullName</h4>
                <p class="text-muted small mb-2">@Model.Email</p>
                <span class="badge bg-primary px-3 py-2 rounded-pill mx-auto mb-3">@Model.Role</span>

                <hr />

                <div class="text-start small text-muted">
                    <div class="mb-2"><i class="bi bi-calendar-check me-2"></i>Member Since: <strong>@Model.MemberSince.ToString("MMM dd, yyyy")</strong></div>
                    <div class="mb-2"><i class="bi bi-journal-text me-2"></i>Total Bookings: <strong>@Model.TotalBookingsCount</strong></div>
                    @if (!string.IsNullOrEmpty(Model.VehiclePlateNumber))
                    {
                        <div><i class="bi bi-card-text me-2"></i>Plate: <strong>@Model.VehiclePlateNumber</strong></div>
                    }
                </div>
            </div>
        </div>

        <!-- Edit Profile & Password Tabs -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4">
                <ul class="nav nav-pills mb-4" id="profileTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="details-tab" data-bs-toggle="pill" data-bs-target="#details" type="button" role="tab"><i class="bi bi-person me-1"></i>Personal & Vehicle Details</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="password-tab" data-bs-toggle="pill" data-bs-target="#password" type="button" role="tab"><i class="bi bi-key me-1"></i>Change Password</button>
                    </li>
                </ul>

                <div class="tab-content" id="profileTabsContent">
                    <!-- Tab 1: Profile Details -->
                    <div class="tab-pane fade show active" id="details" role="tabpanel">
                        <form asp-action="Profile" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="Role" />
                            <input type="hidden" asp-for="MemberSince" />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-semibold small"></label>
                                    <input asp-for="FullName" class="form-control" />
                                    <span asp-validation-for="FullName" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small">Email Address</label>
                                    <input value="@Model.Email" class="form-control bg-light" disabled />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="VehiclePlateNumber" class="form-label fw-semibold small"></label>
                                    <input asp-for="VehiclePlateNumber" class="form-control" placeholder="e.g. NYC-7821" />
                                    <span asp-validation-for="VehiclePlateNumber" class="text-danger small"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="PreferredVehicleType" class="form-label fw-semibold small"></label>
                                    <select asp-for="PreferredVehicleType" class="form-select" asp-items="Html.GetEnumSelectList<VehicleType>()"></select>
                                    <span asp-validation-for="PreferredVehicleType" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary px-4 fw-bold">
                                    <i class="bi bi-save me-1"></i>Save Changes
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Tab 2: Change Password -->
                    <div class="tab-pane fade" id="password" role="tabpanel">
                        <form asp-action="ChangePassword" method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">Current Password</label>
                                <input type="password" name="OldPassword" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold small">New Password</label>
                                <input type="password" name="NewPassword" class="form-control" required minlength="6" />
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold small">Confirm New Password</label>
                                <input type="password" name="ConfirmPassword" class="form-control" required minlength="6" />
                            </div>
                            <button type="submit" class="btn btn-danger px-4 fw-bold">
                                <i class="bi bi-shield-lock me-1"></i>Update Password
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
