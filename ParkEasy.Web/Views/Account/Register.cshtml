@model ParkEasy.Web.Models.ViewModels.RegisterViewModel
@using ParkEasy.Web.Models.Enums
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card border-0 shadow-sm p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold">Create ParkEasy Account</h3>
                    <p class="text-muted small">Join ParkEasy to book spots or list your parking property</p>
                </div>

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Role Selection -->
                    <div class="mb-4">
                        <label class="form-label fw-bold small text-uppercase text-muted">I want to:</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleUser" value="@UserRoles.User" checked />
                                <label class="btn btn-outline-primary w-100 py-3 text-start" for="roleUser">
                                    <i class="bi bi-car-front-fill fs-4 d-block mb-1"></i>
                                    <strong>Book Parking</strong>
                                    <small class="d-block text-muted" style="font-size: 0.75rem;">Driver</small>
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" name="Role" id="roleOwner" value="@UserRoles.Owner" />
                                <label class="btn btn-outline-success w-100 py-3 text-start" for="roleOwner">
                                    <i class="bi bi-building-fill fs-4 d-block mb-1"></i>
                                    <strong>List Parking</strong>
                                    <small class="d-block text-muted" style="font-size: 0.75rem;">Owner</small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label fw-semibold small"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="+1 555-0123" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VehiclePlateNumber" class="form-label fw-semibold small"></label>
                            <input asp-for="VehiclePlateNumber" class="form-control" placeholder="e.g. NYC-1234" />
                            <span asp-validation-for="VehiclePlateNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="PreferredVehicleType" class="form-label fw-semibold small"></label>
                            <select asp-for="PreferredVehicleType" class="form-select" asp-items="Html.GetEnumSelectList<VehicleType>()"></select>
                            <span asp-validation-for="PreferredVehicleType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold small"></label>
                            <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-type password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4 mb-3">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold">
                            <i class="bi bi-person-check-fill me-2"></i>Create Account
                        </button>
                    </div>

                    <div class="text-center">
                        <p class="text-muted small mb-0">
                            Already registered? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign In here</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
