@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 550px;">
        <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
        <h2 class="fw-bold text-danger">Access Denied</h2>
        <p class="text-muted">You do not have permission to access the requested page.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house me-1"></i>Back to Home
            </a>
        </div>
    </div>
</div>
