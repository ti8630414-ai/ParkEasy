@model ParkEasy.Web.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm p-5 mx-auto" style="max-width: 600px;">
        <i class="bi bi-exclamation-triangle-fill text-danger display-1 mb-3"></i>
        <h2 class="fw-bold text-danger">An error occurred</h2>
        <p class="text-muted">An unexpected error occurred while processing your request.</p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="alert alert-light text-muted small my-3">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </div>
        }

        <div class="mt-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-house-door me-1"></i>Return to Home
            </a>
        </div>
    </div>
</div>
