@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm p-4 p-md-5">
        <h2 class="fw-bold text-primary mb-3"><i class="bi bi-shield-check me-2"></i>Privacy Policy</h2>
        <p class="text-secondary">
            This application is an academic software development project for ParkEasy – Smart Parking Slot Booking System. User data is processed strictly for demonstration and reservation simulation purposes.
