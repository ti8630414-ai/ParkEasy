@model List<ParkEasy.Web.Models.Entities.Notification>
@using ParkEasy.Web.Models.Enums
@{
    ViewData["Title"] = "Notification Center";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</h2>
            <p class="text-muted mb-0">System alerts, booking confirmations, and status updates</p>
        </div>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllAsRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                    <i class="bi bi-check-all me-1"></i>Mark All as Read
                </button>
            </form>
        }
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="list-group list-group-flush">
                @foreach (var n in Model)
                {
                    <div class="list-group-item p-3 @(!n.IsRead ? "bg-light bg-opacity-75 border-start border-4 border-primary" : "")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="d-flex align-items-start gap-3">
                                <div class="stat-icon rounded-circle @(!n.IsRead ? "bg-primary text-white" : "bg-light text-muted border")" style="width: 40px; height: 40px; font-size: 1.1rem;">
                                    @if (n.Type == NotificationType.PaymentSuccess)
                                    {
                                        <i class="bi bi-cash-stack"></i>
                                    }
                                    else if (n.Type == NotificationType.BookingCreated || n.Type == NotificationType.BookingApproved)
                                    {
                                        <i class="bi bi-calendar-check"></i>
                                    }
                                    else if (n.Type == NotificationType.BookingCancelled || n.Type == NotificationType.BookingRejected)
                                    {
                                        <i class="bi bi-x-circle"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-info-circle"></i>
                                    }
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-1 @(!n.IsRead ? "text-primary" : "text-dark")">@n.Title</h6>
                                    <p class="mb-1 text-secondary small">@n.Message</p>
                                    <small class="text-muted"><i class="bi bi-clock me-1"></i>@n.CreatedAt.ToString("MMM dd, yyyy - hh:mm tt")</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(n.ActionUrl))
                                {
                                    <a href="@n.ActionUrl" class="btn btn-sm btn-outline-primary" style="font-size: 0.75rem;">
                                        View Details
                                    </a>
                                }

                                @if (!n.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button type="submit" class="btn btn-sm btn-light text-muted" title="Mark Read">
                                            <i class="bi bi-check"></i>
                                        </button>
                                    </form>
                                }

                                <form asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-light text-danger" title="Delete Notification">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white">
            <i class="bi bi-bell-slash text-muted display-4 mb-3"></i>
            <h4 class="fw-bold">No notifications yet</h4>
            <p class="text-muted small">You will receive real-time updates here whenever you make bookings or updates occur.</p>
        </div>
    }
</div>
