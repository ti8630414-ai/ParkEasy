@model ParkEasy.Web.Models.ViewModels.BookingDetailsViewModel
@using ParkEasy.Web.Models.Enums
@{
    ViewData["Title"] = "Booking Reserved - " + Model.BookingReference;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg text-center p-4 p-md-5">
                <div class="rounded-circle bg-success bg-opacity-10 text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-check2-circle fs-1"></i>
                </div>
                <h3 class="fw-bold text-success mb-1">Booking Confirmed!</h3>
                <p class="text-muted small mb-4">Your parking slot has been reserved successfully in our system.</p>

                <!-- Booking Summary Box -->
                <div class="card bg-light border-0 p-3 text-start mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Booking Reference:</span>
                        <strong class="text-primary font-monospace fs-6">@Model.BookingReference</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Parking Location:</span>
                        <strong class="text-dark">@Model.ParkingSpaceName</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Slot Assigned:</span>
                        <span class="badge bg-primary fs-6">Slot @Model.SlotNumber (@Model.FloorOrZone)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Vehicle Plate:</span>
                        <strong class="text-dark font-monospace">@Model.VehiclePlateNumber</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">Start Time:</span>
                        <span>@Model.StartTime.ToString("MMM dd, yyyy - hh:mm tt")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted">End Time:</span>
                        <span>@Model.EndTime.ToString("MMM dd, yyyy - hh:mm tt")</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Total Amount:</span>
                        <strong class="fs-4 text-primary">৳@Model.TotalAmount.ToString("F2")</strong>
                    </div>
                </div>

                @if (Model.PaymentStatus == PaymentStatus.Pending)
                {
                    <div class="d-grid gap-2">
                        <a asp-action="Pass" asp-route-id="@Model.Id" class="btn btn-primary btn-lg fw-bold shadow-sm">
                            <i class="bi bi-qr-code-scan me-2"></i>View / Print Digital QR Pass
                        </a>
                        <a asp-controller="Payment" asp-action="Simulate" asp-route-bookingId="@Model.Id" class="btn btn-success btn-lg fw-bold shadow-sm">
                            <i class="bi bi-credit-card-2-front-fill me-2"></i>Proceed to Payment Simulator
                        </a>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            View Booking Details
                        </a>
                    </div>
                }
                else
                {
                    <div class="alert alert-success small py-2 mb-4">
                        <i class="bi bi-check-circle-fill me-1"></i>
                        Payment Received! Your digital parking pass is active and ready to use.
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="Pass" asp-route-id="@Model.Id" class="btn btn-primary btn-lg fw-bold shadow-sm">
                            <i class="bi bi-qr-code-scan me-2"></i>View / Print Digital QR Pass
                        </a>
                        <a asp-action="History" class="btn btn-outline-secondary">
                            Back to My Bookings
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
