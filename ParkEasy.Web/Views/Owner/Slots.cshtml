@model List<ParkEasy.Web.Models.ViewModels.SlotDetailDto>
@using ParkEasy.Web.Models.Enums
@{
    var space = ViewBag.ParkingSpace as ParkEasy.Web.Models.Entities.ParkingSpace;
    ViewData["Title"] = "Manage Slots - " + (space?.Name ?? "Parking Space");
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Spaces">My Spaces</a></li>
            <li class="breadcrumb-item active" aria-current="page">Slots - @space?.Name</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Slots Management</h2>
            <p class="text-muted mb-0">Managing slots for <strong>@space?.Name</strong> (@Model.Count Total Slots)</p>
        </div>
        <button type="button" class="btn btn-primary rounded-pill px-3 fw-bold mt-2 mt-md-0" data-bs-toggle="modal" data-bs-target="#addSlotModal">
            <i class="bi bi-plus-circle me-1"></i>Add Single Slot
        </button>
    </div>

    <!-- Slots Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Slot #</th>
                        <th>Floor / Zone</th>
                        <th>Vehicle Type</th>
                        <th>Hourly Rate</th>
                        <th>EV Charger</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-primary fs-6 font-monospace">@s.SlotNumber</span>
                                </td>
                                <td><strong>@s.FloorOrZone</strong></td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @s.SupportedVehicleType
                                    </span>
                                </td>
                                <td class="fw-bold text-success">৳@s.PricePerHour.ToString("F2")/hr</td>
                                <td>
                                    @if (s.HasEVCharger)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-lightning-charge-fill me-1"></i>EV Charger</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None</span>
                                    }
                                </td>
                                <td>
                                    @if (!s.IsActive)
                                    {
                                        <span class="badge bg-secondary">Disabled</span>
                                    }
                                    else if (s.CurrentStatus == SlotStatus.Maintenance)
                                    {
                                        <span class="badge bg-warning text-dark">Maintenance</span>
                                    }
                                    else if (s.CurrentStatus == SlotStatus.Occupied)
                                    {
                                        <span class="badge bg-danger">Occupied</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form asp-action="ToggleSlot" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotId" value="@s.Id" />
                                        <input type="hidden" name="spaceId" value="@space?.Id" />
                                        <input type="hidden" name="isActive" value="@(!s.IsActive ? "true" : "false")" />
                                        <button type="submit" class="btn btn-sm @(s.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(s.IsActive ? "Disable Slot" : "Enable Slot")">
                                            <i class="bi @(s.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                        </button>
                                    </form>

                                    <form asp-action="DeleteSlot" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete slot @s.SlotNumber?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slotId" value="@s.Id" />
                                        <input type="hidden" name="spaceId" value="@space?.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Slot">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No slots added yet. Click "Add Single Slot" to create slots.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Slot Modal -->
<div class="modal fade" id="addSlotModal" tabindex="-1" aria-labelledby="addSlotModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addSlotModalLabel"><i class="bi bi-plus-circle me-2"></i>Add Parking Slot</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddSlot" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ParkingSpaceId" value="@space?.Id" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Slot Number (e.g. A-01, G-15)</label>
                        <input type="text" name="SlotNumber" class="form-control text-uppercase font-monospace" placeholder="A-01" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Floor or Zone</label>
                        <input type="text" name="FloorOrZone" class="form-control" value="Ground Floor" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Supported Vehicle Type</label>
                        <select name="SupportedVehicleType" class="form-select" asp-items="Html.GetEnumSelectList<VehicleType>()"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Price Per Hour ($)</label>
                        <input type="number" step="0.5" name="PricePerHour" class="form-control" value="@space?.BasePricePerHour" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="HasEVCharger" value="true" id="addEvCheck" />
                        <label class="form-check-label small" for="addEvCheck">Has EV Fast Charger</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary fw-bold">Add Slot</button>
                </div>
            </form>
        </div>
    </div>
</div>
