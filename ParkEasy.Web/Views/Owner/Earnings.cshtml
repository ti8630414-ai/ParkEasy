@model List<ParkEasy.Web.Models.ViewModels.BookingSummaryViewModel>
@{
    ViewData["Title"] = "Earnings & Revenue Statement";
    var totalEarnings = (decimal)ViewBag.TotalEarnings;
    var totalCount = (int)ViewBag.TotalPaidBookings;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-cash-coin text-success me-2"></i>Earnings & Financial Report</h2>
            <p class="text-muted mb-0">Aggregate revenue ledger from completed and paid bookings</p>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card stat-card success border-0 p-4 shadow-sm">
                <small class="text-muted fw-semibold">Total Revenue Earned</small>
                <h2 class="fw-bold text-success mb-0">৳@totalEarnings.ToString("F2")</h2>
                <small class="text-muted">Calculated from verified paid bookings</small>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card stat-card info border-0 p-4 shadow-sm">
                <small class="text-muted fw-semibold">Total Paid Transactions</small>
                <h2 class="fw-bold text-info mb-0">@totalCount</h2>
                <small class="text-muted">Unique successful parking reservations</small>
            </div>
        </div>
    </div>

    <!-- Transactions Ledger Table -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Completed Transactions</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Transaction Ref</th>
                        <th>Parking Location</th>
                        <th>Slot</th>
                        <th>Date & Time</th>
                        <th>Duration</th>
                        <th>Revenue Amount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="font-monospace text-dark fw-bold">@(item.TransactionId ?? item.BookingReference)</span>
                                </td>
                                <td><strong>@item.ParkingName</strong></td>
                                <td><span class="badge bg-light text-dark border">Slot @item.SlotNumber</span></td>
                                <td>@item.StartTime.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>@item.DurationHours Hours</td>
                                <td class="fw-bold text-success fs-6">+৳@item.TotalAmount.ToString("F2")</td>
                                <td><span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Settled</span></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No transaction revenue records found yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
