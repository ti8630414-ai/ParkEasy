@model List<ParkEasy.Web.Models.ViewModels.ParkingSpaceCardViewModel>
@{
    ViewData["Title"] = "Occupancy Status";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Live Occupancy Analytics</h2>
            <p class="text-muted mb-0">Real-time breakdown of slot occupancy per facility</p>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var s in Model)
        {
            var occupied = Math.Max(0, s.TotalSlots - s.AvailableSlots);
            var rate = s.TotalSlots > 0 ? (double)occupied / s.TotalSlots * 100.0 : 0.0;
            <div class="col-md-6">
                <div class="card border-0 shadow-sm p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">@s.Name</h5>
                        <span class="badge @(rate >= 80 ? "bg-danger" : (rate >= 50 ? "bg-warning text-dark" : "bg-success")) fs-6">
                            @Math.Round(rate, 1)% Full
                        </span>
                    </div>
                    <p class="text-muted small mb-3"><i class="bi bi-geo-alt text-danger me-1"></i>@s.Address, @s.City</p>

                    <div class="progress mb-3" style="height: 16px; border-radius: 8px;">
                        <div class="progress-bar @(rate >= 80 ? "bg-danger" : (rate >= 50 ? "bg-warning" : "bg-success"))" 
                             role="progressbar" 
                             style="width: @rate%;" 
                             aria-valuenow="@rate" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                        </div>
                    </div>

                    <div class="row text-center g-2 pt-2 border-top">
                        <div class="col-4">
                            <small class="text-muted d-block">Total Slots</small>
                            <strong class="fs-5 text-dark">@s.TotalSlots</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block">Occupied</small>
                            <strong class="fs-5 text-danger">@occupied</strong>
                        </div>
                        <div class="col-4">
                            <small class="text-muted d-block">Available</small>
                            <strong class="fs-5 text-success">@s.AvailableSlots</strong>
                        </div>
                    </div>

                    <div class="mt-3 text-end">
                        <a asp-action="Slots" asp-route-spaceId="@s.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-grid-3x3-gap me-1"></i>View Slots
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
