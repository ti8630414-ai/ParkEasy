@model List<ParkEasy.Web.Models.ViewModels.ParkingSpaceCardViewModel>
@{
    ViewData["Title"] = "My Parking Spaces";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-p-square-fill text-success me-2"></i>My Parking Spaces</h2>
            <p class="text-muted mb-0">Manage your listed parking facilities and configurations</p>
        </div>
        <a asp-action="CreateSpace" class="btn btn-success rounded-pill px-3 fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Add New Parking Space
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var space in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden">
                        <div class="position-relative" style="height: 180px; background-color: #cbd5e1;">
                            @if (!string.IsNullOrEmpty(space.ImageUrl))
                            {
                                <img src="@space.ImageUrl" class="w-100 h-100 object-fit-cover" alt="@space.Name" onerror="this.src='https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&w=600&q=80'" />
                            }
                            else
                            {
                                <img src="https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&w=600&q=80" class="w-100 h-100 object-fit-cover" alt="Parking Space" />
                            }
                            <span class="position-absolute top-0 end-0 m-2 badge bg-primary px-2 py-1 fw-bold fs-6">
                                ৳@space.BasePricePerHour.ToString("F2")/hr
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="fw-bold mb-1">@space.Name</h5>
                            <p class="text-muted small mb-3"><i class="bi bi-geo-alt text-danger me-1"></i>@space.Address, @space.City</p>

                            <div class="d-flex justify-content-between align-items-center mb-3 p-2 bg-light rounded">
                                <span class="small text-muted">Slots Occupancy:</span>
                                <span class="badge @(space.AvailableSlots > 0 ? "bg-success" : "bg-danger")">
                                    @space.AvailableSlots Available / @space.TotalSlots Total
                                </span>
                            </div>

                            <div class="mt-auto pt-3 border-top d-flex flex-wrap gap-2">
                                <a asp-action="Slots" asp-route-spaceId="@space.Id" class="btn btn-sm btn-primary flex-fill fw-semibold">
                                    <i class="bi bi-grid-3x3-gap me-1"></i>Manage Slots (@space.TotalSlots)
                                </a>
                                <a asp-action="EditSpace" asp-route-id="@space.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="Parking" asp-action="Details" asp-route-id="@space.Id" class="btn btn-sm btn-outline-info" title="Preview Public Page" target="_blank">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <form asp-action="DeleteSpace" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this parking space and all its slots?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@space.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Space">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm p-5 text-center bg-white">
            <i class="bi bi-building-x text-muted display-3 mb-3"></i>
            <h4 class="fw-bold">No parking spaces listed yet</h4>
            <p class="text-muted">Start by creating your first parking space location.</p>
            <div>
                <a asp-action="CreateSpace" class="btn btn-success rounded-pill px-4 fw-bold">
                    <i class="bi bi-plus-circle me-1"></i>Add Parking Space
                </a>
            </div>
        </div>
    }
</div>
